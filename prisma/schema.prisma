datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -----------------------------------------------------------------------------
// 1. Identity & Authentication (Auth.js / NextAuth v5)
// -----------------------------------------------------------------------------

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  emailVerified  DateTime?
  image          String?
  password       String?
  avatar         String?
  jobTitle       String?   @default("Software Engineer")
  status         String    @default("ACTIVE") // ACTIVE, SUSPENDED, PENDING
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Multi-Tenancy Relations
  memberships         Membership[]
  teamMemberships     TeamMember[]
  projectMembers      ProjectMember[]
  ownedProjects       Project[]             @relation("ProjectOwner")
  createdProjects     Project[]             @relation("ProjectCreator")
  sentInvitations     Invitation[]          @relation("InvitedBy")
  passwordResetTokens PasswordResetToken[]

  // Issue & Activity Relations
  assignedIssues      Issue[]               @relation("Assignee")
  reportedIssues      Issue[]               @relation("Reporter")
  comments            Comment[]
  uploadedAttachments Attachment[]
  issueActivities     IssueActivity[]
  timeLogs            TimeLog[]
  watchedIssues       IssueWatcher[]
  notifications       Notification[]             @relation("NotificationUser")
  sentNotifications   Notification[]             @relation("NotificationActor")

  // Auth.js Core Relations
  accounts       Account[]
  sessions       Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// -----------------------------------------------------------------------------
// 2. Multi-Tenancy: Organizations, Memberships & Invitations
// -----------------------------------------------------------------------------

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  logoUrl     String?
  status      String   @default("ACTIVE") // ACTIVE, ARCHIVED, SUSPENDED
  plan        String   @default("FREE") // FREE, TEAM, PRO, BUSINESS, ENTERPRISE
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships     Membership[]
  teams           Team[]
  projects        Project[]
  sprints         Sprint[]
  issues          Issue[]
  labels          Label[]
  invitations     Invitation[]
  auditLogs       AuditLog[]
  workflows       Workflow[]
  customFields    CustomField[]
  automationRules AutomationRule[]
  slaPolicies     SlaPolicy[]
  timeLogs        TimeLog[]
  releases        Release[]
  issueWatchers   IssueWatcher[]
  notifications   Notification[]
  billingAccount  BillingAccount?
  subscription    Subscription?
  paymentMethods  PaymentMethod[]
  invoices        Invoice[]
  paymentTransactions PaymentTransaction[]

  @@index([slug])
}

model Membership {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("MEMBER") // OWNER, ADMIN, PROJECT_ADMIN, PROJECT_MANAGER, DEVELOPER, QA_ENGINEER, PRODUCT_MANAGER, REPORTER, VIEWER, GUEST
  status         String       @default("ACTIVE") // ACTIVE, INVITED, SUSPENDED

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([token])
}

model Invitation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String       @default("MEMBER") // OWNER, ADMIN, MEMBER, GUEST
  token          String       @unique
  expiresAt      DateTime
  inviterId      String
  inviter        User         @relation("InvitedBy", fields: [inviterId], references: [id], onDelete: Cascade)
  status         String       @default("PENDING") // PENDING, ACCEPTED, EXPIRED, REVOKED

  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([token])
}

// -----------------------------------------------------------------------------
// 3. Teams & Squads
// -----------------------------------------------------------------------------

model Team {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  members        TeamMember[]
  projects       Project[]
  issues         Issue[]

  @@index([organizationId])
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("MEMBER") // LEAD, MEMBER

  createdAt DateTime @default(now())

  @@unique([teamId, userId])
  @@index([userId])
}

// -----------------------------------------------------------------------------
// 4. Projects & Project Memberships (Phase 2)
// -----------------------------------------------------------------------------

model Project {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  key            String          // Unique project identifier (e.g. ACME, PAY, WEB)
  description    String?
  category       String          @default("Software Development")
  projectType    String          @default("SOFTWARE") // SOFTWARE, SERVICE_DESK, BUSINESS
  status         String          @default("ACTIVE") // ACTIVE, ARCHIVED, COMPLETED

  ownerId        String?
  owner          User?           @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  teamId         String?
  team           Team?           @relation(fields: [teamId], references: [id], onDelete: SetNull)

  startDate      DateTime?
  targetDate     DateTime?

  createdById    String?
  createdBy      User?           @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: SetNull)

  issueCounter   Int             @default(0)

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  issues          Issue[]
  sprints         Sprint[]
  milestones      Milestone[]
  members         ProjectMember[]
  labels          Label[]
  workflows       Workflow[]
  customFields    CustomField[]
  automationRules AutomationRule[]
  slaPolicies     SlaPolicy[]
  releases        Release[]

  @@unique([organizationId, key])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([teamId])
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("DEVELOPER") // PROJECT_ADMIN, PROJECT_MANAGER, DEVELOPER, QA_ENGINEER, REPORTER, VIEWER

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([projectId, userId])
  @@index([userId])
  @@index([projectId])
}

model Milestone {
  id          String    @id @default(cuid())
  name        String
  description String?
  status      String    @default("OPEN")
  dueDate     DateTime?
  createdAt   DateTime  @default(now())

  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues      Issue[]

  @@index([projectId])
}

model Sprint {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId       String
  project         Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name            String
  goal            String?
  status          String       @default("PLANNING") // PLANNING, ACTIVE, COMPLETED, CANCELLED

  startDate       DateTime?
  endDate         DateTime?
  completedAt     DateTime?

  totalPoints     Float        @default(0)
  completedPoints Float        @default(0)

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  issues          Issue[]

  @@index([organizationId, projectId])
  @@index([projectId, status])
}

// -----------------------------------------------------------------------------
// 5. Issues, Bugs, Comments & Relationships (Phase 2)
// -----------------------------------------------------------------------------

model Issue {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId       String
  project         Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  teamId          String?
  team            Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)

  key             String       // e.g. ACME-12
  number          Int          @default(1)
  title           String
  description     String?

  type            String       @default("TASK") // EPIC, STORY, TASK, BUG, SUBTASK, FEATURE, IMPROVEMENT, SUPPORT_TICKET, CHANGE_REQUEST
  status          String       @default("TODO") // BACKLOG, TODO, IN_PROGRESS, CODE_REVIEW, QA, DONE, REOPENED, DUPLICATE, REJECTED, WONT_FIX, CANNOT_REPRODUCE, CLOSED
  priority        String       @default("MEDIUM") // CRITICAL, HIGH, MEDIUM, LOW, LOWEST
  severity        String?      // BLOCKER, CRITICAL, MAJOR, MINOR, TRIVIAL (specifically for BUGs)

  // Environment & Bug Fields
  environment     String?      @default("Production")
  module          String?      @default("General")
  reproducibility String?      @default("Always")
  operatingSystem String?
  browser         String?
  device          String?
  appVersion      String?
  stepsToReproduce String?
  expectedResult  String?
  actualResult    String?
  logs            String?
  stackTrace      String?
  component       String?

  // Estimates & Time
  estimate        Float?       // Hours
  timeSpent       Float?       // Hours
  storyPoints     Float?       // Agile story points (1, 2, 3, 5, 8, 13, 21...)
  startDate       DateTime?    // Roadmap start date
  targetDate      DateTime?    // Roadmap target date
  dueDate         DateTime?

  // Issue Hierarchy
  parentIssueId   String?
  parentIssue     Issue?       @relation("IssueHierarchy", fields: [parentIssueId], references: [id], onDelete: SetNull)
  subIssues       Issue[]      @relation("IssueHierarchy")

  // Epic Link
  epicId          String?
  epic            Issue?       @relation("EpicIssues", fields: [epicId], references: [id], onDelete: SetNull)
  epicIssues      Issue[]      @relation("EpicIssues")

  // Sprint Link
  sprintId        String?
  sprint          Sprint?      @relation(fields: [sprintId], references: [id], onDelete: SetNull)

  milestoneId     String?
  milestone       Milestone?   @relation(fields: [milestoneId], references: [id], onDelete: SetNull)

  assigneeId      String?
  assignee        User?        @relation("Assignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  reporterId      String?
  reporter        User?        @relation("Reporter", fields: [reporterId], references: [id], onDelete: SetNull)

  // Release Link
  releaseId       String?
  release         Release?            @relation(fields: [releaseId], references: [id], onDelete: SetNull)

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  comments        Comment[]
  labels          IssueLabel[]
  attachments     Attachment[]
  activities      IssueActivity[]
  timeLogs        TimeLog[]
  customFieldValues CustomFieldValue[]
  issueSla        IssueSla?
  sourceRelations IssueRelationship[] @relation("SourceIssue")
  targetRelations IssueRelationship[] @relation("TargetIssue")
  watchers        IssueWatcher[]
  notifications   Notification[]

  @@unique([organizationId, key])
  @@index([organizationId, projectId])
  @@index([projectId, status])
  @@index([projectId, priority])
  @@index([assigneeId])
  @@index([reporterId])
  @@index([parentIssueId])
  @@index([epicId])
  @@index([sprintId])
  @@index([releaseId])
  @@index([teamId])
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  issueId   String
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)

  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([issueId])
}

model Label {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      String?
  project        Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name           String
  color          String       @default("#3b82f6") // Hex color
  description    String?
  createdAt      DateTime     @default(now())

  issues         IssueLabel[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([projectId])
}

model IssueLabel {
  id        String   @id @default(cuid())
  issueId   String
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  labelId   String
  label     Label    @relation(fields: [labelId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([issueId, labelId])
  @@index([issueId])
  @@index([labelId])
}

model IssueRelationship {
  id            String   @id @default(cuid())
  sourceIssueId String
  sourceIssue   Issue    @relation("SourceIssue", fields: [sourceIssueId], references: [id], onDelete: Cascade)
  targetIssueId String
  targetIssue   Issue    @relation("TargetIssue", fields: [targetIssueId], references: [id], onDelete: Cascade)
  type          String   // PARENT_CHILD, BLOCKS, BLOCKED_BY, RELATES_TO, DUPLICATE, DUPLICATED_BY
  createdAt     DateTime @default(now())

  @@unique([sourceIssueId, targetIssueId, type])
  @@index([sourceIssueId])
  @@index([targetIssueId])
}

model IssueActivity {
  id        String   @id @default(cuid())
  issueId   String
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String   // CREATED, UPDATED, STATUS_CHANGED, PRIORITY_CHANGED, ASSIGNEE_CHANGED, COMMENT_ADDED, ATTACHMENT_ADDED, RELATIONSHIP_ADDED
  field     String?
  oldValue  String?
  newValue  String?
  metadata  String?  // JSON formatted details
  createdAt DateTime @default(now())

  @@index([issueId, createdAt])
}

model Attachment {
  id         String   @id @default(cuid())
  issueId    String
  issue      Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  fileName   String
  fileSize   Int
  mimeType   String
  url        String
  uploaderId String?
  uploader   User?    @relation(fields: [uploaderId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@index([issueId])
}

// -----------------------------------------------------------------------------
// 6. Security & Audit Trail
// -----------------------------------------------------------------------------

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorUserId    String?
  action         String       // e.g. "USER_INVITED", "ROLE_UPDATED", "PROJECT_CREATED"
  resourceType   String       // e.g. "ORGANIZATION", "TEAM", "PROJECT", "ISSUE"
  resourceId     String?
  details        String?      // JSON metadata string
  ipAddress      String?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
}

// -----------------------------------------------------------------------------
// 7. Advanced Project Management: Workflows, Custom Fields, Automation, SLA, Time, Releases (Phase 4)
// -----------------------------------------------------------------------------

model Workflow {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      String?
  project        Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name           String
  description    String?
  isDefault      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  statuses       WorkflowStatus[]
  transitions    WorkflowTransition[]

  @@index([organizationId])
  @@index([projectId])
}

model WorkflowStatus {
  id          String   @id @default(cuid())
  workflowId  String
  workflow    Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  name        String
  key         String   // Normalized uppercase key, e.g. "TRIAGED", "CODE_REVIEW"
  category    String   @default("IN_PROGRESS") // TODO, IN_PROGRESS, DONE
  color       String   @default("#3b82f6")
  order       Int      @default(0)

  fromTransitions WorkflowTransition[] @relation("FromStatus")
  toTransitions   WorkflowTransition[] @relation("ToStatus")

  @@unique([workflowId, key])
  @@index([workflowId])
}

model WorkflowTransition {
  id              String          @id @default(cuid())
  workflowId      String
  workflow        Workflow        @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  name            String
  fromStatusId    String?
  fromStatus      WorkflowStatus? @relation("FromStatus", fields: [fromStatusId], references: [id], onDelete: Cascade)
  toStatusId      String
  toStatus        WorkflowStatus  @relation("ToStatus", fields: [toStatusId], references: [id], onDelete: Cascade)

  requiredRole    String?         // Required RBAC role (e.g. "QA_ENGINEER", "PROJECT_ADMIN")
  validationRules String?         // JSON array of strings e.g. ["REQUIRE_ASSIGNEE", "REQUIRE_RESOLUTION"]

  createdAt       DateTime        @default(now())

  @@index([workflowId])
  @@index([fromStatusId])
  @@index([toStatusId])
}

model CustomField {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      String?
  project        Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name           String       // Display label e.g. "Customer Impact"
  fieldKey       String       // Machine key e.g. "customer_impact"
  type           String       // TEXT, NUMBER, DATE, DROPDOWN, MULTI_SELECT, CHECKBOX, USER, URL, EMAIL, FORMULA
  description    String?
  options        String?      // JSON string array for DROPDOWN/MULTI_SELECT
  defaultValue   String?
  isRequired     Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  values         CustomFieldValue[]

  @@unique([organizationId, fieldKey])
  @@index([organizationId])
  @@index([projectId])
}

model CustomFieldValue {
  id            String      @id @default(cuid())
  issueId       String
  issue         Issue       @relation(fields: [issueId], references: [id], onDelete: Cascade)
  customFieldId String
  customField   CustomField @relation(fields: [customFieldId], references: [id], onDelete: Cascade)
  value         String?     // Serialized value
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([issueId, customFieldId])
  @@index([issueId])
  @@index([customFieldId])
}

model AutomationRule {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      String?
  project        Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name           String
  description    String?
  triggerType    String       // issue:created, issue:status_changed, issue:priority_changed, issue:comment_added, sprint:started, sprint:completed
  conditions     String       // JSON array of conditions e.g. [{"field":"priority","operator":"equals","value":"CRITICAL"}]
  actions        String       // JSON array of actions e.g. [{"type":"CHANGE_STATUS","value":"IN_PROGRESS"}]
  isActive       Boolean      @default(true)
  executionCount Int          @default(0)
  lastExecutedAt DateTime?

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  executionLogs  AutomationExecutionLog[]

  @@index([organizationId])
  @@index([projectId])
}

model AutomationExecutionLog {
  id           String         @id @default(cuid())
  ruleId       String
  rule         AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  triggerEvent String
  issueId      String?
  status       String         // SUCCESS, FAILED, SKIPPED
  details      String?        // JSON summary
  executedAt   DateTime       @default(now())

  @@index([ruleId, executedAt])
}

model SlaPolicy {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      String?
  project        Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name           String
  description    String?
  isDefault      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  targets        SlaTarget[]

  @@index([organizationId])
  @@index([projectId])
}

model SlaTarget {
  id               String    @id @default(cuid())
  policyId         String
  policy           SlaPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  priority         String    // CRITICAL, HIGH, MEDIUM, LOW, LOWEST
  responseHours    Float     // Hours to first response
  resolutionHours  Float     // Hours to final resolution

  @@unique([policyId, priority])
  @@index([policyId])
}

model IssueSla {
  id               String   @id @default(cuid())
  issueId          String   @unique
  issue            Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  policyId         String

  firstResponseAt  DateTime?
  resolvedAt       DateTime?
  responseDueAt    DateTime
  resolutionDueAt  DateTime
  responseStatus   String   @default("HEALTHY") // HEALTHY, AT_RISK, BREACHED, MET
  resolutionStatus String   @default("HEALTHY") // HEALTHY, AT_RISK, BREACHED, MET

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([policyId])
  @@index([responseStatus])
  @@index([resolutionStatus])
}

model TimeLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  issueId        String
  issue          Issue        @relation(fields: [issueId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  timeSpent      Float        // Hours logged (e.g. 1.5)
  description    String?
  billable       Boolean      @default(true)
  loggedAt       DateTime     @default(now())
  startedAt      DateTime?
  endedAt        DateTime?

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, issueId])
  @@index([userId])
  @@index([loggedAt])
}

model Notification {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation("NotificationUser", fields: [userId], references: [id], onDelete: Cascade)

  type           String       // ISSUE_ASSIGNED, ISSUE_STATUS_CHANGED, ISSUE_COMMENTED, ISSUE_UPDATED, ISSUE_CREATED, WATCHER_ADDED
  title          String
  body           String?
  issueId        String?
  issue          Issue?       @relation(fields: [issueId], references: [id], onDelete: Cascade)
  actorId        String?
  actor          User?        @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([userId, readAt])
  @@index([organizationId, createdAt])
  @@index([issueId])
}

model Release {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      String
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  version        String       // e.g. "v1.0.0"
  name           String       // e.g. "Enterprise GA Release"
  description    String?
  releaseDate    DateTime?
  status         String       @default("UNRELEASED") // UNRELEASED, RELEASED, ARCHIVED
  releaseNotes   String?

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  issues         Issue[]

  @@unique([projectId, version])
  @@index([organizationId, projectId])
  @@index([projectId, status])
}

model IssueWatcher {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  issueId        String
  issue          Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@unique([issueId, userId])
  @@index([organizationId, issueId])
  @@index([userId])
}

// -----------------------------------------------------------------------------
// 12. Enterprise Billing, Subscriptions & Payment Methods
// -----------------------------------------------------------------------------

model BillingAccount {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  billingEmail      String
  companyName       String?
  taxId             String?
  taxIdType         String? // VAT, GST, EIN, ABN, GSTIN
  addressLine1      String?
  addressLine2      String?
  city              String?
  region            String?
  postalCode        String?
  country           String  @default("US")
  currency          String  @default("USD")
  collectionMethod  String  @default("CHARGE_AUTOMATICALLY") // CHARGE_AUTOMATICALLY, SEND_INVOICE
  poNumber          String?
  netTermsDays      Int     @default(30)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  paymentMethods      PaymentMethod[]
  invoices            Invoice[]
  subscription        Subscription?
  paymentTransactions PaymentTransaction[]

  @@index([organizationId])
}

model Subscription {
  id               String         @id @default(cuid())
  organizationId   String         @unique
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  billingAccountId String         @unique
  billingAccount   BillingAccount @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)

  planKey          String   @default("FREE") // FREE, TEAM, BUSINESS, ENTERPRISE
  status           String   @default("ACTIVE") // TRIALING, ACTIVE, PAST_DUE, CANCELED, UNPAID
  billingInterval  String   @default("MONTHLY") // MONTHLY, YEARLY
  seatQuantity     Int      @default(5)
  trialEndsAt      DateTime?
  currentPeriodStart DateTime @default(now())
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean  @default(false)
  canceledAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, status])
}

model PaymentMethod {
  id               String         @id @default(cuid())
  organizationId   String
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  billingAccountId String
  billingAccount   BillingAccount @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)

  type          String  // CARD, ACH, SEPA_DEBIT, WIRE, INVOICE
  brand         String? // visa, mastercard, amex, discover, bank
  last4         String
  expMonth      Int?
  expYear       Int?
  holderName    String?
  bankName      String?
  fingerprint   String
  billingCountry String?
  isDefault     Boolean @default(false)
  status        String  @default("ACTIVE") // ACTIVE, EXPIRED, FAILED, REMOVED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  invoices  Invoice[]
  paymentTransactions PaymentTransaction[]

  @@index([organizationId, status])
  @@index([billingAccountId])
  @@index([fingerprint])
}

model Invoice {
  id               String         @id @default(cuid())
  organizationId   String
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  billingAccountId String
  billingAccount   BillingAccount @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)
  paymentMethodId  String?
  paymentMethod    PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)

  number          String @unique
  status          String @default("OPEN") // DRAFT, OPEN, PAID, VOID, UNCOLLECTIBLE
  currency        String @default("USD")
  subtotalCents   Int
  taxCents        Int    @default(0)
  totalCents      Int
  amountPaidCents Int    @default(0)
  periodStart     DateTime
  periodEnd       DateTime
  dueDate         DateTime
  paidAt          DateTime?
  lineItemsJson   String // JSON array of { description, quantity, unitAmountCents }
  memo            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  paymentTransactions PaymentTransaction[]

  @@index([organizationId, createdAt])
  @@index([billingAccountId])
  @@index([status])
}

model PaymentTransaction {
  id               String         @id @default(cuid())
  organizationId   String
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  billingAccountId String
  billingAccount   BillingAccount @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)
  invoiceId        String?
  invoice          Invoice?       @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  paymentMethodId  String?
  paymentMethod    PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)

  amountCents         Int
  currency            String   @default("USD")
  status              String   @default("PENDING") // PENDING, PROCESSING, SUCCEEDED, FAILED, REFUNDED
  type                String   @default("CHARGE") // CHARGE, REFUND, VERIFICATION
  gateway             String   @default("STRIPE_SANDBOX")
  gatewayTransactionId String
  gatewayResponseCode String?
  failureReason       String?
  refundedAmountCents Int      @default(0)
  description         String?
  metadata            String?  // JSON string
  ipAddress           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, createdAt])
  @@index([billingAccountId])
  @@index([invoiceId])
  @@index([paymentMethodId])
  @@index([status])
  @@index([gatewayTransactionId])
}
