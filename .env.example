# Authentication & Session
AUTH_SECRET="change-this-to-a-secure-32-byte-hex-secret-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Multi-Tenant Database
# In local development: "file:./dev.db" (SQLite) or "postgresql://postgres:postgres@localhost:5432/bugtracker?schema=public"
# In staging/production: Managed PostgreSQL connection string (Supabase, Neon, AWS RDS, etc.)
DATABASE_URL="file:./dev.db"

# Redis Cache & Background Queue (BullMQ)
REDIS_URL="redis://localhost:6379"

# Object Storage (S3 / Cloudflare R2 / MinIO)
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET_NAME="bugtracker-attachments"

# OAuth Providers (Optional in local dev)
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Billing (optional). Local mode tokenizes cards in-process and never stores PAN/CVC.
# Set these only when wiring a production processor later.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
BILLING_PROVIDER="local"
