# Authentication & Session
AUTH_SECRET="change-this-to-a-secure-32-byte-hex-secret-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Multi-Tenant Database
# In local development: "file:./dev.db" (SQLite) or "postgresql://postgres:postgres@localhost:5432/bugtracker?schema=public"
# In staging/production: Managed PostgreSQL connection string (Supabase, Neon, AWS RDS, etc.)
DATABASE_URL="file:./dev.db"

# Redis Cache & Background Queue (BullMQ)
REDIS_URL="redis://localhost:6379"

# Object Storage (S3 / Cloudflare R2 / MinIO)
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET_NAME="bugtracker-attachments"

# OAuth Providers (Optional in local dev)
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Billing. Keep local sandbox mode unless Stripe test credentials are configured.
# Never use live keys until the production flow has been explicitly approved.
APP_BASE_URL="http://localhost:3000"
BILLING_PROVIDER="local"
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_LIVE_MODE_APPROVED="false"
STRIPE_AUTOMATIC_TAX="false"
STRIPE_PRICE_TEAM_MONTHLY=""
STRIPE_PRICE_TEAM_YEARLY=""
STRIPE_PRICE_TEAM_EXTRA_SEAT_MONTHLY=""
STRIPE_PRICE_TEAM_EXTRA_SEAT_YEARLY=""
STRIPE_PRICE_BUSINESS_MONTHLY=""
STRIPE_PRICE_BUSINESS_YEARLY=""
STRIPE_PRICE_BUSINESS_EXTRA_SEAT_MONTHLY=""
STRIPE_PRICE_BUSINESS_EXTRA_SEAT_YEARLY=""
STRIPE_PRICE_ENTERPRISE_MONTHLY=""
STRIPE_PRICE_ENTERPRISE_YEARLY=""
STRIPE_PRICE_ENTERPRISE_EXTRA_SEAT_MONTHLY=""
STRIPE_PRICE_ENTERPRISE_EXTRA_SEAT_YEARLY=""
